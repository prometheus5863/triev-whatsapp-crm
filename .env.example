PORT=3000

# Gupshup Enterprise Gateway. Leave blank to run in DRY_RUN (nothing is sent).
GUPSHUP_ACCOUNT_ID=
GUPSHUP_PASSWORD=

# Google Apps Script web-app URL that appends a ticket row to the sheet.
SHEET_WEBHOOK_URL=

# Optional: require ?secret=<value> on the webhook URL registered with Gupshup.
WEBHOOK_SECRET=

SESSION_TTL_MINUTES=30
